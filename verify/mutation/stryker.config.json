{
	"$schema": "../../node_modules/@stryker-mutator/core/schema/stryker-schema.json",
	"testRunner": "vitest",
	"plugins": ["@stryker-mutator/vitest-runner"],
	"coverageAnalysis": "perTest",
	"disableBail": true,
	"incremental": true,
	"incrementalFile": ".claude/stryker-incremental.json",
	"reporters": ["json", "progress"],
	"jsonReporter": {
		"fileName": ".claude/stryker-report.json"
	},
	"mutate": ["src/**/*.ts"],
	"vitest": {
		"configFile": "verify/mutation/vitest.config.ts"
	}
}
