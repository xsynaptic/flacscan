{
	"name": "flacscan",
	"version": "4.1.1",
	"description": "Periodic integrity verification for large FLAC collections",
	"keywords": [
		"flac",
		"bitrot",
		"integrity",
		"audio",
		"cli"
	],
	"type": "module",
	"bin": {
		"flacscan": "./dist/index.mjs"
	},
	"engines": {
		"node": ">=24.0.0"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/xysnaptic/flacscan.git"
	},
	"files": [
		"dist",
		"flacscan.config.example.yaml"
	],
	"scripts": {
		"dev": "tsx src/index.ts",
		"build": "tsdown",
		"fix": "prettier --write . --cache && eslint --fix --cache --cache-location node_modules/.cache/eslint/ && tsc --noEmit && knip && vitest run",
		"check": "prettier --check . && eslint && tsc --noEmit && knip && vitest run",
		"lint": "eslint . --fix",
		"check-types": "tsc --noEmit",
		"knip": "knip",
		"test": "vitest run",
		"changeset": "changeset",
		"release": "pnpm build && changeset publish",
		"postrelease": "git push --follow-tags origin main",
		"prebuild": "pnpm check",
		"prepublishOnly": "pnpm build"
	},
	"dependencies": {
		"better-sqlite3": "^13.0.3",
		"chalk": "^6.0.1",
		"citty": "^0.2.2",
		"ora": "^10.0.0",
		"yaml": "^2.9.1"
	},
	"devDependencies": {
		"@changesets/cli": "^3.0.3",
		"@eslint/js": "^10.0.1",
		"@types/better-sqlite3": "^9.6.0",
		"@types/node": "^24.19.2",
		"eslint": "^10.14.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-perfectionist": "^5.13.0",
		"eslint-plugin-unicorn": "^79.0.0",
		"jiti": "^2.7.0",
		"knip": "^6.44.1",
		"prettier": "^3.9.10",
		"tsdown": "^0.23.4",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.1",
		"vitest": "^5.1.0"
	},
	"knip": {
		"ignoreBinaries": [
			"flac"
		],
		"vitest": {
			"entry": [
				"tests/**/*.test.ts"
			]
		}
	},
	"license": "MIT",
	"packageManager": "pnpm@12.14.0"
}
