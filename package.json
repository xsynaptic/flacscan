{
	"name": "flacscan",
	"version": "4.1.0",
	"description": "Periodic integrity verification for large FLAC collections",
	"keywords": [
		"flac",
		"bitrot",
		"integrity",
		"audio",
		"cli"
	],
	"type": "module",
	"bin": {
		"flacscan": "./dist/index.mjs"
	},
	"engines": {
		"node": ">=24.0.0"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/xysnaptic/flacscan.git"
	},
	"files": [
		"dist",
		"flacscan.config.example.yaml"
	],
	"scripts": {
		"dev": "tsx src/index.ts",
		"build": "tsdown",
		"fix": "prettier --write . --cache && eslint --fix --cache --cache-location node_modules/.cache/eslint/ && tsc --noEmit && knip && vitest run",
		"check": "prettier --check . && eslint && tsc --noEmit && knip && vitest run",
		"lint": "eslint . --fix",
		"check-types": "tsc --noEmit",
		"knip": "knip",
		"test": "vitest run",
		"changeset": "changeset",
		"release": "pnpm build && changeset publish",
		"postrelease": "git push --follow-tags origin main",
		"prebuild": "pnpm check",
		"prepublishOnly": "pnpm build"
	},
	"dependencies": {
		"better-sqlite3": "^12.11.1",
		"chalk": "^5.4.1",
		"citty": "^0.2.2",
		"ora": "^9.4.1",
		"yaml": "^2.9.0"
	},
	"devDependencies": {
		"@changesets/cli": "^2.31.0",
		"@eslint/js": "^10.0.1",
		"@types/better-sqlite3": "^7.6.13",
		"@types/node": "^24.13.2",
		"eslint": "^10.6.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-perfectionist": "^5.10.0",
		"eslint-plugin-unicorn": "^71.1.0",
		"jiti": "^2.7.0",
		"knip": "^6.25.0",
		"prettier": "^3.9.4",
		"tsdown": "^0.22.3",
		"tsx": "^4.23.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.63.0",
		"vitest": "^4.1.10"
	},
	"knip": {
		"ignoreBinaries": [
			"flac"
		],
		"vitest": {
			"entry": [
				"tests/**/*.test.ts"
			]
		}
	},
	"license": "MIT",
	"packageManager": "pnpm@11.5.2+sha512.71c631e382066efc25625d5cf029075de07b61b37f6e27350fbd84b1bda5864c8c1967adc280776b45c30a715c0359a3be08fef42d5bb09e2b99029979692916"
}
