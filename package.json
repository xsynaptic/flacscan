{
	"name": "flacscan",
	"version": "2.1.0",
	"description": "Periodic integrity verification for large FLAC collections",
	"keywords": [
		"flac",
		"bitrot",
		"integrity",
		"audio",
		"cli"
	],
	"type": "module",
	"bin": {
		"flacscan": "./dist/index.mjs"
	},
	"engines": {
		"node": ">=22.22.2"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/xysnaptic/flacscan.git"
	},
	"files": [
		"dist",
		"flacscan.config.example.yaml"
	],
	"scripts": {
		"dev": "tsx src/index.ts",
		"build": "tsdown",
		"format": "prettier --write . && eslint --fix . && knip && tsc --noEmit && vitest run",
		"check": "prettier --check . && eslint . && knip && tsc --noEmit && vitest run",
		"lint": "eslint . --fix",
		"check-types": "tsc --noEmit",
		"knip": "knip",
		"test": "vitest run",
		"prebuild": "pnpm check",
		"prepublishOnly": "pnpm build"
	},
	"dependencies": {
		"better-sqlite3": "^12.10.0",
		"chalk": "^5.4.1",
		"citty": "^0.2.2",
		"ora": "^9.4.0",
		"yaml": "^2.9.0"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@types/better-sqlite3": "^7.6.13",
		"@types/node": "^25.9.1",
		"eslint": "^9.39.4",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-perfectionist": "^5.9.0",
		"eslint-plugin-unicorn": "^64.0.0",
		"jiti": "^2.7.0",
		"knip": "^6.15.0",
		"prettier": "^3.8.3",
		"tsdown": "^0.22.2",
		"tsx": "^4.22.4",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vitest": "^4.1.8"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"better-sqlite3",
			"esbuild"
		]
	},
	"knip": {
		"vitest": {
			"entry": [
				"tests/**/*.test.ts"
			]
		}
	},
	"license": "MIT",
	"packageManager": "pnpm@11.0.9+sha512.34ce82e6780233cf9cad8685029a8f81d2e06196c5a9bad98879f7424940c6817c4e4524fb7d38b8553ceed48b9758b8ebaf1abd3600c232c4c8cf7366086f38"
}
