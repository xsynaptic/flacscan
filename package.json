{
	"name": "flacscan",
	"version": "4.3.1",
	"description": "Periodic integrity verification for large FLAC collections",
	"keywords": [
		"flac",
		"bitrot",
		"integrity",
		"audio",
		"cli"
	],
	"type": "module",
	"imports": {
		"#*": "./src/*"
	},
	"bin": {
		"flacscan": "./dist/index.mjs"
	},
	"engines": {
		"node": ">=24.0.0"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/xsynaptic/flacscan.git"
	},
	"files": [
		"dist",
		"flacscan.config.example.yaml"
	],
	"scripts": {
		"dev": "node src/index.ts",
		"build": "tsdown",
		"prebuild": "pnpm check",
		"check": "lefthook run check",
		"fix": "lefthook run fix",
		"test": "vitest run",
		"changeset": "changeset",
		"release": "node scripts/release.ts",
		"prepublishOnly": "pnpm build"
	},
	"dependencies": {
		"better-sqlite3": "^13.0.3",
		"chalk": "^6.0.1",
		"citty": "^0.2.2",
		"ora": "^10.0.0",
		"yaml": "^2.9.1"
	},
	"devDependencies": {
		"@changesets/cli": "^3.0.3",
		"@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
		"@eslint/js": "^10.0.1",
		"@fast-check/vitest": "^0.5.0",
		"@types/better-sqlite3": "^9.6.0",
		"@types/node": "^24.19.2",
		"eslint": "^10.14.0",
		"eslint-plugin-perfectionist": "^5.13.0",
		"eslint-plugin-unicorn": "^79.0.0",
		"fallow": "^3.39.0",
		"globals": "^17.14.0",
		"jiti": "^2.7.0",
		"knip": "^6.44.1",
		"lefthook": "^2.2.2",
		"prettier": "^3.9.10",
		"publint": "^0.3.25",
		"tsdown": "^0.23.5",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.1",
		"vitest": "^5.1.0"
	},
	"license": "MIT",
	"packageManager": "pnpm@12.14.0"
}
